# 01_hello.be - your first program
# Lines that start with # are comments. BE skips them.

dekhao "Hello, Bangladesh!"

dhoro nam = "Shuvo"
dekhao "My name is " + nam

# {nam} inside text puts the value of nam there (a template)
dekhao "My name is {nam} and I am learning BE"

# Commas print several values with spaces between them
dekhao "Name:", nam, "| Age:", 22
